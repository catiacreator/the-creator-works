# ─────────────────────────────────────────────────────────────
# CCreator Lab — variáveis de ambiente
# Copia para .env.local e preenche.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Chave para cifrar tokens de OAuth guardados na base de dados.
# Gera com:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ─── IA (opcional — só para a Cát.IA e para o modo em que a app escreve os slides)
# Três hipóteses. A ordem de preferência é: Anthropic → Lovable → OpenAI.

# 1. Anthropic (Claude) — o caminho recomendado.
ANTHROPIC_API_KEY=

# 2. Gateway do Lovable — compatível com a API da OpenAI, gasta os créditos
#    do teu workspace Lovable. A chave está nos secrets do teu projeto Lovable.
LOVABLE_API_KEY=
# Força um deles quando tiveres mais do que um: 'claude', 'lovable' ou 'openai'
AI_PROVIDER=
# Modelo por defeito. Com o Lovable: google/gemini-3-flash-preview
AI_TEXT_MODEL=

# 3. OpenAI, com chave própria
# Podes deixar vazio aqui e pôr a chave nas Definições da app (fica cifrada na BD).
OPENAI_API_KEY=

# Canva Connect (opcional — a Autofill API exige Canva Enterprise)
# https://www.canva.com/developers/ → Integrations
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:3000/api/canva/oauth/callback

# Google Drive (opcional — importar ficheiros do Drive)
# https://console.cloud.google.com/ → APIs & Services → Credentials (OAuth client, tipo Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback

# Segredo partilhado para chamar /api/jobs/run a partir de um cron externo
JOBS_RUN_SECRET=muda-isto

# Quem pode entrar na app, além da catiacreator@gmail.com (separados por vírgulas).
# Deixa vazio para ser só ela.
EMAILS_COM_ACESSO=
